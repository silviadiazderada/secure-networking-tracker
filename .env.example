# ---------------------------------------------------------------------------
# Copy this file to .env.local and fill in real values from the Neon console.
# .env.local is gitignored and must never be committed.
# ---------------------------------------------------------------------------

# PUBLIC — safe to expose to the browser (prefixed with NEXT_PUBLIC_).
# These are the two URLs the frontend uses via @neondatabase/neon-js.
NEXT_PUBLIC_NEON_AUTH_URL=https://your-neon-auth-endpoint.neon.tech
NEXT_PUBLIC_NEON_DATA_API_URL=https://your-neon-data-api-endpoint.neon.tech

# SERVER-ONLY — never exposed to the browser, never committed.
# Used locally / in CI only, to run the SQL migration in db/migrations/.
# The deployed app does NOT need this at runtime (all data access goes
# through the Neon Data API, protected by Row Level Security).
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# SERVER-ONLY — only needed if a Better Auth server helper is added later.
NEON_AUTH_BASE_URL=https://your-neon-auth-endpoint.neon.tech
NEON_AUTH_COOKIE_SECRET=replace-with-a-long-random-string
